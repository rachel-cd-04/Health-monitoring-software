# Credentials for a dedicated Supabase test project only. Do not use production URLs.
# Get both connection strings from the Supabase project's Connect panel.
DATABASE_URL="postgresql://postgres.<test-project-ref>:<password>@<pooler-host>:6543/postgres?sslmode=require"
DIRECT_URL="postgresql://postgres.<test-project-ref>:<password>@<pooler-host>:5432/postgres?sslmode=require"

# Use a unique secret for this local test backend.
JWT_SECRET="replace-with-a-long-random-test-secret"
PORT=3000

# Optional assistant settings. The test flows do not call the hosted LLM.
LLM_API_KEY=
LLM_BASE_URL="https://integrate.api.nvidia.com/v1"
LLM_MODEL="nvidia/nemotron-3.5-super-vl-120b-a12b"
