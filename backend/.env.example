DATABASE_URL="postgresql://postgres:<database-password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require"
DIRECT_URL="postgresql://postgres.<project-ref>:<database-password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
JWT_SECRET="long-random-string"
# AI assistant (MOD-02): any OpenAI-compatible API; NVIDIA NIM by default.
# Create a key (starts with nvapi-) at https://build.nvidia.com/settings/api-keys — backend only, never in the frontend.
# Without it, POST /api/assistant/chat answers 503 AI_UNAVAILABLE and the rest of the app keeps working.
LLM_API_KEY=
LLM_BASE_URL="https://integrate.api.nvidia.com/v1"
# Must include the vendor prefix (vendor/model). Team choice (MOD-03), the one that performed best in our tests.
LLM_MODEL="nvidia/nemotron-3.5-super-vl-120b-a12b"
# Optional: request timeout in milliseconds (the SDK also retries 429/5xx twice with backoff).
LLM_TIMEOUT_MS=30000
# Optional: minimum pause between LLM requests inside one agentic loop, in ms (values below 1000 are raised to 1000).
LLM_COOLDOWN_MS=1000
PORT=3000
