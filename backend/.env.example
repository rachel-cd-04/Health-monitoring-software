# Copy the connection strings from Supabase Dashboard → Connect. Do not commit the real .env.
# Runtime URL: transaction pooler (port 6543); use the exact host and username Supabase gives you.
DATABASE_URL="postgresql://postgres.<project-ref>:<database-password>@<pooler-host>:6543/postgres?pgbouncer=true&sslmode=require"
# Prisma migrations: session pooler (port 5432). A direct connection from Supabase also works;
# copy that full string from the Connect panel if your network supports IPv6 (or has IPv4 enabled).
DIRECT_URL="postgresql://postgres.<project-ref>:<database-password>@<pooler-host>:5432/postgres?sslmode=require"
# Generate a unique random secret, for example with: openssl rand -base64 32
JWT_SECRET="replace-with-a-long-random-secret"
# AI assistant (MOD-02): any OpenAI-compatible API; NVIDIA NIM by default.
# Create a key (starts with nvapi-) at https://build.nvidia.com/settings/api-keys — backend only, never in the frontend.
# Without it, POST /api/assistant/chat answers 503 AI_UNAVAILABLE and the rest of the app keeps working.
LLM_API_KEY=
LLM_BASE_URL="https://integrate.api.nvidia.com/v1"
# Must include the vendor prefix (vendor/model). Team choice (MOD-03), the one that performed best in our tests.
LLM_MODEL="nvidia/nemotron-3.5-super-vl-120b-a12b"
# Optional: request timeout in milliseconds (the SDK also retries 429/5xx twice with backoff).
LLM_TIMEOUT_MS=30000
# Optional: minimum pause between LLM requests inside one agentic loop, in ms (values below 1000 are raised to 1000).
LLM_COOLDOWN_MS=1000
PORT=3000
