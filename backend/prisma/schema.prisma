generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AstronautRole {
  crew
  commander
}

enum DataSource {
  manual
  simulated
  sensor
}

enum MissionPhase {
  pre
  in_flight
  post
}

enum AlertLevel {
  green
  amber
  red
}

enum EmergencyScenario {
  chest_pain
  collapsed
  breathing
  bleeding
  other
}

enum RadiationSource {
  simulated
  imported
  sensor
}

model Astronaut {
  id                Int              @id @default(autoincrement())
  name              String
  role              AstronautRole    @default(crew)
  avatar            String?
  pinHash           String?          @map("pin_hash")
  failedPinAttempts Int              @default(0) @map("failed_pin_attempts") @db.SmallInt
  lockedUntil       DateTime?        @map("locked_until") @db.Timestamptz(6)
  missionStart      DateTime?        @map("mission_start") @db.Date
  baseline          Json?
  measurements      Measurement[]
  checkins          Checkin[]
  alerts            Alert[]
  patientEvents     EmergencyEvent[] @relation("PatientEvents")
  reportedEvents    EmergencyEvent[] @relation("ReporterEvents")
  routineItems      RoutineItem[]

  @@map("astronauts")
}

model Source {
  id         String    @id
  agency     String
  title      String
  url        String
  docType    String?   @map("doc_type")
  accessedOn DateTime? @map("accessed_on") @db.Date
  rules      Rule[]

  @@map("sources")
}

model Measurement {
  id           BigInt        @id @default(autoincrement())
  astronautId  Int           @map("astronaut_id")
  indicator    String
  value        Decimal       @db.Decimal(10, 3)
  unit         String
  ts           DateTime      @default(now()) @db.Timestamptz(6)
  source       DataSource
  missionPhase MissionPhase? @map("mission_phase")
  extra        Json?
  astronaut    Astronaut     @relation(fields: [astronautId], references: [id])
  alerts       Alert[]

  @@index([astronautId, indicator, ts])
  @@map("measurements")
}

model Checkin {
  id          BigInt     @id @default(autoincrement())
  astronautId Int        @map("astronaut_id")
  day         DateTime   @db.Date
  sleepHours  Decimal?   @map("sleep_hours") @db.Decimal(5, 2)
  mood        Int?       @db.SmallInt
  fatigue     Int?       @db.SmallInt
  source      DataSource
  astronaut   Astronaut  @relation(fields: [astronautId], references: [id])

  @@unique([astronautId, day])
  @@index([astronautId, day])
  @@map("checkins")
}

model Rule {
  id         String
  version    Int
  indicator  String
  bodySystem String?     @map("body_system")
  condition  String
  level      AlertLevel?
  whoActs    String[]    @map("who_acts")
  message    String
  actions    String[]
  sourceId   String?     @map("source_id")
  source     Source?     @relation(fields: [sourceId], references: [id])
  alerts     Alert[]

  @@id([id, version])
  @@map("rules")
}

model Alert {
  id             BigInt       @id @default(autoincrement())
  astronautId    Int          @map("astronaut_id")
  ruleId         String       @map("rule_id")
  ruleVersion    Int          @map("rule_version")
  indicator      String
  value          Decimal?     @db.Decimal(10, 3)
  measurementId  BigInt?      @map("measurement_id")
  level          AlertLevel
  message        String
  ts             DateTime     @default(now()) @db.Timestamptz(6)
  active         Boolean      @default(true)
  acknowledgedAt DateTime?    @map("acknowledged_at") @db.Timestamptz(6)
  astronaut      Astronaut    @relation(fields: [astronautId], references: [id])
  rule           Rule         @relation(fields: [ruleId, ruleVersion], references: [id, version])
  measurement    Measurement? @relation(fields: [measurementId], references: [id])

  @@index([astronautId, active])
  @@map("alerts")
}

model RoutineItem {
  id          BigInt    @id @default(autoincrement())
  astronautId Int       @map("astronaut_id")
  item        String
  dueAt       DateTime  @map("due_at") @db.Timestamptz(6)
  done        Boolean   @default(false)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)
  astronaut   Astronaut @relation(fields: [astronautId], references: [id])

  @@index([astronautId, dueAt])
  @@map("routine_items")
}

model EmergencyEvent {
  id         String            @id @default(uuid()) @db.Uuid
  patientId  Int?              @map("patient_id")
  reporterId Int?              @map("reporter_id")
  scenario   EmergencyScenario
  startedAt  DateTime          @default(now()) @map("started_at") @db.Timestamptz(6)
  endedAt    DateTime?         @map("ended_at") @db.Timestamptz(6)
  source     DataSource        @default(simulated)
  patient    Astronaut?        @relation("PatientEvents", fields: [patientId], references: [id])
  reporter   Astronaut?        @relation("ReporterEvents", fields: [reporterId], references: [id])
  steps      EmergencyStep[]

  @@index([patientId, startedAt])
  @@map("emergency_events")
}

model EmergencyStep {
  id             String         @id @default(uuid()) @db.Uuid
  eventId        String         @map("event_id") @db.Uuid
  ts             DateTime       @default(now()) @db.Timestamptz(6)
  stepId         String         @map("step_id")
  answer         String?
  vitalIndicator String?        @map("vital_indicator")
  vitalValue     Decimal?       @map("vital_value") @db.Decimal(10, 3)
  event          EmergencyEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, ts])
  @@map("emergency_steps")
}

model RadiationEvent {
  id            BigInt          @id @default(autoincrement())
  ts            DateTime        @db.Timestamptz(6)
  doseMsv       Decimal?        @map("dose_msv") @db.Decimal(10, 3)
  doseRateUsvH  Decimal?        @map("dose_rate_usv_h") @db.Decimal(10, 3)
  radiationType String?         @map("radiation_type")
  location      String?
  instrument    String?
  eventType     String?         @map("event_type")
  source        RadiationSource @default(simulated)

  @@index([ts])
  @@map("radiation_events")
}
