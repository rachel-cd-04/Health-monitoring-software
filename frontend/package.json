{
  "name": "soma-flight-health",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:e2e": "VITE_API_URL=http://localhost:3000 vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run --spec cypress/e2e/core-flows.cy.js",
    "cypress:open:supabase": "cypress open --e2e --config-file cypress.supabase.config.js",
    "cypress:run:supabase": "cypress run --config-file cypress.supabase.config.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@tanstack/react-query": "^5.107.1",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "cypress": "^16.3.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.0.0",
    "prettier": "^3.0.0",
    "vite": "^6.1.0"
  }
}
